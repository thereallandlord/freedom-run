{
  "name": "freedom-run",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "export BUILD_ID=$(date +%s) && vite build && node scripts/write-version.mjs dist $BUILD_ID",
    "preview": "vite preview",
    "test": "esbuild src/engine/selftest.ts --bundle --platform=node --format=esm --outfile=.selftest.mjs --log-level=error && node .selftest.mjs",
    "test:mech": "esbuild src/engine/mechtest.ts --bundle --platform=node --format=esm --outfile=.mech.mjs --log-level=error && node .mech.mjs",
    "test:all": "npm run test:mech && npm test && npm run test:phase && npm run test:turn && npm run test:meme && npm run test:stage && npm run test:world && npm run test:events && npm run test:passport && npm run test:biz && npm run test:keys",
    "dump:state": "esbuild src/engine/dumpstate.ts --bundle --platform=node --format=esm --outfile=.dump.mjs --log-level=error && node .dump.mjs",
    "test:scen": "npx tsx src/engine/scenarios.ts",
    "fuzz": "npx tsx src/engine/fuzz.ts",
    "audit": "npx tsx src/engine/audit.ts",
    "test:phase": "npx tsx src/engine/phasetest.ts",
    "test:turn": "npx tsx src/engine/dupturntest.ts",
    "test:deck": "npx tsx src/engine/repeattest.ts",
    "test:meme": "npx tsx src/engine/memetest.ts",
    "bots": "npx tsx src/engine/botmeter.ts",
    "test:stage": "npx tsx src/engine/stagetest.ts",
    "test:world": "npx tsx src/engine/worldwaittest.ts",
    "test:events": "npx tsx src/engine/eventtest.ts",
    "test:passport": "npx tsx src/engine/passporttest.ts",
    "test:biz": "npx tsx src/engine/biztest.ts",
    "test:keys": "npx tsx src/engine/keystest.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}