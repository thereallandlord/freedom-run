{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noUnusedLocals": false
  },
  "include": ["src"],
  "exclude": ["src/engine/audit.ts", "src/engine/fuzz.ts", "src/engine/scenarios.ts", "src/engine/__ftdown.ts", "src/engine/__scratch", "src/engine/selftest.ts", "src/engine/dumpstate.ts", "src/engine/dumpgame.ts", "src/engine/mechtest.ts", "src/engine/calib.ts", "src/engine/sweep.ts", "src/engine/diag.ts"]
}
